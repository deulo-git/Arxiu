# Port i adreça on escolta el servidor
PORT=3000
# HOST=0.0.0.0

# URL pública (s'usa als enllaços dels correus i als enllaços compartits)
PUBLIC_URL=http://localhost:3000

# On es guarden la base de dades i els documents
DATA_DIR=./data

# Correu (recuperació de contrasenya). Sense SMTP_URL, els correus s'escriuen al registre.
# SMTP_URL=smtps://usuari:contrasenya@smtp.exemple.cat:465
# MAIL_FROM=Arxiu <arxiu@exemple.cat>

# Límits
# MAX_UPLOAD_MB=50
# SESSION_MAX_DAYS=30
# SHARE_HOURS=24
