# Copia aquest fitxer a «.env» (cp .env.example .env) i omple'l.
# El fitxer .env no es puja mai a GitHub.

# Adreça de l'Arxiu. Sense domini propi, fes servir la IP del servidor amb sslip.io:
# si la IP és 1.2.3.4 → arxiu.1-2-3-4.sslip.io
ARXIU_DOMAIN=arxiu.1-2-3-4.sslip.io
PUBLIC_URL=https://arxiu.1-2-3-4.sslip.io

# Correu per als avisos de Let's Encrypt (certificats HTTPS)
ACME_EMAIL=tu@gmail.com

# Correu de recuperació de contrasenya. Amb Gmail cal una «contrasenya d'aplicació»
# (Compte de Google → Seguretat → Verificació en dos passos → Contrasenyes d'aplicació).
# L'@ de l'usuari s'escriu %40 i la contrasenya d'aplicació sense espais.
# SMTP_URL=smtps://tu%40gmail.com:abcdabcdabcdabcd@smtp.gmail.com:465
# MAIL_FROM=Arxiu <tu@gmail.com>
