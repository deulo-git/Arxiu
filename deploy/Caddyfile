# Cada bloc és una web. Caddy demana i renova els certificats HTTPS sol.
{
	email {$ACME_EMAIL}
}

# Arxiu
{$ARXIU_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy arxiu:3000
}

